---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Início | Central da Fork">
  <main class="inicio">
    <span class="etiqueta">FORK COMMUNITY</span>

    <h1>Central da Fork<span>.</span></h1>

    <p>
      O código conecta, a fork aproxima.
      Tudo o que está rolando na Fork, em um lugar só.
    </p>

    <section class="cartoes" aria-label="Áreas da Central">
      <article class="cartao">
        <h2>Operação</h2>
        <p>Eventos, conteúdos, projetos, tarefas, pessoas e reuniões.</p>
      </article>

      <article class="cartao">
        <h2>Equipes</h2>
        <p>O painel de trabalho de cada time da comunidade.</p>
      </article>

      <article class="cartao">
        <h2>Wiki</h2>
        <p>Identidade visual, regras, orientações e modelos.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .inicio {
    max-width: 1100px;
    margin-inline: auto;
    padding: var(--espaco-12) var(--espaco-6);
  }

  .etiqueta {
    color: var(--destaque);
    font-size: var(--texto-pequeno);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin-block: var(--espaco-4);
    font-size: var(--texto-titulo);
    font-weight: 800;
  }

  h1 span {
    color: var(--laranja);
  }

  .inicio > p {
    max-width: 600px;
    color: var(--texto-suave);
  }

  .cartoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--espaco-6);
    margin-top: var(--espaco-8);
  }

  .cartao {
    padding: var(--espaco-6);
    background: var(--superficie);
    border: 1px solid var(--borda);
    border-radius: var(--raio-grande);
    box-shadow: var(--sombra);
  }

  .cartao h2 {
    margin-bottom: var(--espaco-3);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .cartao p {
    color: var(--texto-suave);
    font-size: var(--texto-pequeno);
  }

  @media (max-width: 700px) {
    .cartoes {
      grid-template-columns: 1fr;
    }
  }
</style>